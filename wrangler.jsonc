{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-ai-studio",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "previews": {}
}
